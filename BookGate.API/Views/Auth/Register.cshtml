@model BookGate.Application.DTOs.RegisterDTO
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null; // Hoặc Layout = "_Layout" tùy cấu trúc dự án của bạn
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký - Book Gate</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* Giữ nguyên toàn bộ CSS bạn đã cung cấp */
       body {
            font-family: 'Inter', sans-serif;
            height: 100vh;
            margin: 0;
            overflow: hidden;
        }

        .login-sidebar {
    /* Thiết lập hình ảnh nền lấp đầy toàn bộ */
    background-image: url('/uploads/banner/522977464_1151409953685292_4950967811551467365_n.jpg');
    background-size: cover; /* Hình ảnh sẽ co giãn để che phủ toàn bộ vùng chứa */
    background-position: center; /* Căn giữa hình ảnh */
    background-repeat: no-repeat; /* Không lặp lại hình ảnh */

    /* Giữ nguyên các thuộc tính khác để định vị logo */
    display: flex;
    flex-direction: column;
    padding: 40px;
    position: relative;
    height: 100vh; /* Đảm bảo chiều cao lấp đầy màn hình */
}

/* Xóa hoặc ẩn thẻ <img> trong HTML vì chúng ta đã dùng background-image */
.placeholder-image-container {
    display: none; /* Hoặc xóa hoàn toàn khỏi HTML */
}

/* Đảm bảo logo "Book Gate" hiển thị rõ ràng trên nền ảnh */
.brand-logo {
    font-weight: 700;
    font-size: 1.5rem;
    color: #fff; /* Đổi màu chữ thành trắng để nổi bật trên nền ảnh */
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 10; /* Đảm bảo logo nằm trên cùng */
}lign-items: center;
        }

        .placeholder-icon {
            font-size: 200px;
            color: #fff;
        }

        .login-content {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px;
        }

        .login-box {
            width: 100%;
            max-width: 400px;
        }

        .login-box h2 {
            font-weight: 700;
            margin-bottom: 25px;
        }

        /* Thêm các CSS khác của bạn ở đây... */
        
        .validation-summary-errors {
            border-radius: 8px;
        }
        .validation-summary-errors ul {
            list-style-type: none; 
            padding: 0; 
            margin: 0;
            text-align: center; 
        }
        .validation-summary-errors li {
            color: #dc3545;
            font-weight: 500;
        }

        .left-panel {
            background-color: #b1bdc5;
        }

        .logo {
            font-size: 1.5rem;
            color: #333;
        }

        .input-group-custom {
            position: relative;
        }

            .input-group-custom label {
                position: absolute;
                top: -12px;
                left: 15px;
                background: white;
                padding: 0 8px;
                font-size: 0.85rem;
                z-index: 1;
                color: #333;
            }

            .input-group-custom .form-control {
                border: 1.5px solid #333;
                border-radius: 8px;
                height: 48px;
                box-shadow: none;
            }

                .input-group-custom .form-control:focus {
                    border-color: #00a0ff;
                    box-shadow: 0 0 0 0.2rem rgba(0, 160, 255, 0.25);
                }

        .password-toggle {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #666;
            z-index: 10;
        }

        .btn-register {
            background-color: #00a0ff;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            color: white;
            transition: 0.3s;
        }

            .btn-register:hover {
                background-color: #0087d8;
                color: white;
            }

        .text-danger {
            font-size: 0.8rem;
        }

        @@media (max-width: 768px) {
            body {
                overflow: auto;
            }

            .vh-100 {
                height: auto !important;
                min-height: 100vh;
            }
        }
    </style>
</head>
<body>

    <div class="container-fluid p-0 h-100">
        <div class="row g-0 h-100">
            <div class="col-lg-4 d-none d-lg-flex login-sidebar">
                <a href="/" class="brand-logo">
                    <i class="bi bi-book-half"></i> Book Gate
                </a>
            </div>

            <div class="col-md-7 d-flex align-items-center justify-content-center bg-white">
                <div class="register-form w-75" style="max-width: 450px;">
                    <h2 class="fw-bold mb-1">Đăng ký</h2>
                    <p class="text-muted mb-4">Hãy đến và tạo một tài khoản</p>

                    <form asp-action="Register" method="POST">
                        @Html.AntiForgeryToken()

                        <div class="input-group-custom mb-4">
                            <label asp-for="FullName">Họ và tên</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="input-group-custom mb-4">
                            <label asp-for="Username">Tên tài khoản</label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="input-group-custom mb-4">
                            <label asp-for="Email">Email</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="input-group-custom mb-4">
                            <label asp-for="PhoneNumber">Số điện thoại</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="input-group-custom mb-4">
                            <label asp-for="Password">Mật khẩu</label>
                            <div class="position-relative">
                                <input asp-for="Password" id="passwordField" class="form-control" />
                                <i class="bi bi-eye-slash password-toggle" id="toggleIcon"></i>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 mt-2 btn-register">Đăng ký</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        const toggleIcon = document.getElementById('toggleIcon');
        const passwordField = document.getElementById('passwordField');

        toggleIcon.addEventListener('click', function () {
            const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordField.setAttribute('type', type);
            this.classList.toggle('bi-eye');
            this.classList.toggle('bi-eye-slash');
        });
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>