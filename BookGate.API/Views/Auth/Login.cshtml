@model BookGate.Application.DTOs.LoginDTO
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Gate - Đăng nhập</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            height: 100vh;
            margin: 0;
            overflow: hidden;
        }
        /* Giữ nguyên toàn bộ CSS của bạn */
        .login-sidebar {
    /* Thiết lập hình ảnh nền lấp đầy toàn bộ */
    background-image: url('/uploads/banner/522977464_1151409953685292_4950967811551467365_n.jpg');
    background-size: cover; /* Hình ảnh sẽ co giãn để che phủ toàn bộ vùng chứa */
    background-position: center; /* Căn giữa hình ảnh */
    background-repeat: no-repeat; /* Không lặp lại hình ảnh */

    /* Giữ nguyên các thuộc tính khác để định vị logo */
    display: flex;
    flex-direction: column;
    padding: 40px;
    position: relative;
    height: 100vh; /* Đảm bảo chiều cao lấp đầy màn hình */
}

/* Xóa hoặc ẩn thẻ <img> trong HTML vì chúng ta đã dùng background-image */
.placeholder-image-container {
    display: none; /* Hoặc xóa hoàn toàn khỏi HTML */
}

/* Đảm bảo logo "Book Gate" hiển thị rõ ràng trên nền ảnh */
.brand-logo {
    font-weight: 700;
    font-size: 1.5rem;
    color: #fff; /* Đổi màu chữ thành trắng để nổi bật trên nền ảnh */
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 10; /* Đảm bảo logo nằm trên cùng */
}

        .placeholder-image-container {
            flex-grow: 1;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .placeholder-icon {
            font-size: 200px;
            color: #fff;
        }

        .login-content {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px;
        }

        .login-box {
            width: 100%;
            max-width: 400px;
        }

            .login-box h2 {
                font-weight: 700;
                margin-bottom: 25px;
            }

        .btn-social {
            border: 1px solid #ced4da;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 12px;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: background 0.2s;
        }

            .btn-social:hover {
                background-color: #f8f9fa;
            }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            color: #adb5bd;
            margin: 20px 0;
        }

            .divider::before, .divider::after {
                content: '';
                flex: 1;
                border-bottom: 1px solid #dee2e6;
            }

            .divider span {
                padding: 0 10px;
                font-size: 0.9rem;
            }

        .form-label-group {
            position: relative;
            margin-bottom: 15px;
        }

        .form-control {
            border-radius: 8px;
            padding: 12px 15px;
            border: 1.5px solid #dee2e6;
        }

            .form-control:focus {
                box-shadow: none;
                border-color: #00a8ff;
            }

        .password-toggle {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #6c757d;
        }

        .btn-login {
            background-color: #00a8ff;
            border: none;
            border-radius: 8px;
            padding: 12px;
            font-weight: 600;
            width: 100%;
            margin-top: 10px;
            color: white;
        }

            .btn-login:hover {
                background-color: #0097e6;
            }

        .auth-footer-links {
            font-size: 0.9rem;
            text-align: center;
            margin-top: 20px;
        }

            .auth-footer-links a {
                color: #00a8ff;
                text-decoration: none;
                font-weight: 600;
            }

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.85rem;
            margin-bottom: 20px;
        }

        .text-danger {
            font-size: 0.8rem;
        }
        .validation-summary-errors {
            border-radius: 8px;
        }
                .validation-summary-errors ul {
                    list-style-type: none; 
                    padding: 0; 
                    margin: 0;
                    text-align: center; 
                }
                .validation-summary-errors li {
                    color: #dc3545;
                    font-weight: 500;
                }
    </style>
</head>
<body>

    <div class="container-fluid p-0 h-100">
        <div class="row g-0 h-100">
            <div class="col-lg-4 d-none d-lg-flex login-sidebar">
            <a href="/" class="brand-logo">
                <i class="bi bi-book-half"></i> Book Gate
            </a>
            </div>
            <div class="col-lg-8 login-content">
                <div class="login-box">
                    <h2>Đăng nhập</h2>

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        
                        
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold" style="font-size: 0.85rem;">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="Nhập email của bạn">
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold" style="font-size: 0.85rem;">Mật khẩu</label>
                            <div class="form-label-group">
                                <input asp-for="Password" id="passwordField" class="form-control" placeholder="••••••••">
                                <i class="bi bi-eye-slash password-toggle" id="toggleIcon"></i>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-options">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox">
                                <label class="form-check-label text-muted">
                                    Ghi nhớ đăng nhập
                                </label>
                            </div>
                            <a href="#" class="text-decoration-none fw-semibold">Quên mật khẩu?</a>
                        </div>

                        <button type="submit" class="btn btn-primary btn-login">Đăng nhập</button>
                    </form>

                    <div class="auth-footer-links">
                        <span class="text-muted">Chưa có tài khoản?</span>
                        <a asp-action="Register" asp-controller="Auth">Đăng ký ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const toggleIcon = document.getElementById('toggleIcon');
        const passwordField = document.getElementById('passwordField');

        toggleIcon.addEventListener('click', function () {
            const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordField.setAttribute('type', type);
            this.classList.toggle('bi-eye');
            this.classList.toggle('bi-eye-slash');
        });
    </script>
   
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

    @if (!ViewData.ModelState.IsValid)
    {
        var errorMessages = ViewData.ModelState.Values
            .SelectMany(x => x.Errors)
            .Select(x => x.ErrorMessage)
            .ToList();

        <script>
            document.addEventListener("DOMContentLoaded", function() {
                // Lặp qua các lỗi (nếu có nhiều lỗi) và hiển thị
                @foreach (var error in errorMessages)
                {
                    <text>
                    Toastify({
                        text: "@Html.Raw(error)",           // Lấy nội dung lỗi từ Controller (VD: "Sai tài khoản hoặc mật khẩu")
                        duration: 3500,            // Thời gian hiển thị (3.5 giây)
                        close: true,               // Hiển thị nút X để tắt
                        gravity: "bottom",         // Hiển thị ở dưới (bottom) hoặc trên (top)
                        position: "right",         // Hiển thị bên phải (right), trái (left), hoặc giữa (center)
                        style: {
                            background: "#dc3545", // Màu nền đỏ cảnh báo (chuẩn class danger của Bootstrap)
                            borderRadius: "8px",   // Bo góc cho đồng bộ với form
                            fontFamily: "Inter, sans-serif",
                            fontSize: "14px",
                            fontWeight: "500"
                        }
                    }).showToast();
                    </text>
                }
            });
        </script>
    }
</body>
</html>