@using BookGate.Application.DTOs
@model IEnumerable<BookDTO>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Gate - Quản lý sách</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --bg-color: #f4f7fc;
            --surface-color: #ffffff;
            --text-main: #1e1e2d;
            --text-muted: #8b92a5;
            --primary-color: #2b3445;
            --active-bg: #f1f3f9;
            --border-radius: 16px;
            --blue-accent: #009dff;
        }

        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; /* Đã trả về phông chữ gốc của bạn */
            background-color: var(--bg-color); 
            color: var(--text-main); 
            overflow-x: hidden;
            margin: 0;
        }

        /* --- LAYOUT TỔNG --- */
        .app-wrapper {
            display: flex;
            min-height: 100vh;
            padding: 20px;
            gap: 24px;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            width: 240px;
            background: var(--surface-color);
            border-radius: var(--border-radius);
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
            position: sticky;
            top: 20px;
            height: calc(100vh - 40px);
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-main);
            text-decoration: none;
            margin-bottom: 40px;
            padding-left: 8px;
        }

        .brand-logo i { color: #f5b041; font-size: 1.5rem; }

        .nav-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 12px 16px;
            border-radius: 12px;
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .nav-item.active {
            background-color: var(--active-bg);
            color: var(--text-main);
            font-weight: 600;
        }

        .nav-item:hover:not(.active) {
            color: var(--text-main);
            background-color: rgba(0,0,0,0.02);
        }

        .nav-item i { font-size: 1.2rem; }
        .logout-link { margin-top: auto; color: #e74c3c !important; }

        /* --- MAIN CONTENT & HEADER --- */
        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .top-header {
            background: var(--surface-color);
            border-radius: var(--border-radius);
            padding: 16px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        }

        .search-box {
            display: flex;
            align-items: center;
            background: var(--bg-color);
            padding: 10px 20px;
            border-radius: 50px;
            width: 400px;
            gap: 12px;
        }

        .search-box input {
            border: none;
            background: transparent;
            outline: none;
            width: 100%;
            font-family: inherit;
            font-size: 0.95rem;
        }

        .profile-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .icon-btn {
            width: 40px; height: 40px;
            border-radius: 50%;
            border: 1px solid #e5e7eb;
            display: flex; align-items: center; justify-content: center;
            color: var(--text-main);
            text-decoration: none;
            font-size: 1.1rem;
        }

        /* --- QUẢN LÝ SÁCH SPECIFIC STYLES --- */
        .btn-custom-blue {
            background-color: var(--blue-accent);
            color: white;
            border: none;
            padding: 10px 24px;
            font-weight: 500;
            transition: all 0.2s;
        }
        .btn-custom-blue:hover {
            background-color: #0081d6;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0, 157, 255, 0.2);
        }

        .admin-book-card {
            background: var(--surface-color);
            border-radius: var(--border-radius);
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
            border: 1px solid transparent;
            transition: all 0.2s ease;
        }
        .admin-book-card:hover {
            border-color: #e5e7eb;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        }

        .book-cover-placeholder {
            width: 130px;
            height: 195px; /* Aspect ratio 2:3 */
            background-color: #e2e8f0;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #a0aec0;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .text-label {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .text-value {
            font-size: 0.95rem;
            font-weight: 500;
            color: var(--text-main);
        }

        .btn-close-custom {
            font-size: 1.2rem;
            color: #e74c3c;
            cursor: pointer;
            background: rgba(231, 76, 60, 0.1);
            border: none;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }
        .btn-close-custom:hover {
            background: #e74c3c;
            color: #fff;
        }

        /* Custom Pagination */
        .pagination .page-link {
            color: var(--text-main);
            border-radius: 8px;
            margin: 0 4px;
            border: 1px solid transparent;
            background: var(--surface-color);
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
            font-weight: 500;
        }
        .pagination .page-link:hover {
            background-color: var(--bg-color);
            border-color: #e2e8f0;
        }
        .pagination .page-item.active .page-link {
            background-color: var(--blue-accent);
            border-color: var(--blue-accent);
            color: white;
        }
        .pagination .page-item.disabled .page-link {
            color: var(--text-muted);
            background: transparent;
            box-shadow: none;
        }
    </style>
</head>
<body>

    <div class="app-wrapper">
        
        <aside class="sidebar">
            <a asp-controller="Admin" asp-action="Index" class="brand-logo">
                <i class="bi bi-book-half"></i> Book Gate
            </a>
            
            <ul class="nav-menu">
                <li>
                    <a asp-controller="Admin" asp-action="Index" class="nav-item">
                        <i class="bi bi-house-door"></i> Tổng quan
                    </a>
                </li>
                <li>
                    <a asp-controller="Book" asp-action="Index" class="nav-item active">
                        <i class="bi bi-journal-text"></i> Quản lý sách
                    </a>
                </li>
                <li>
                    <a asp-controller="OrderStatus" asp-action="IndexAdmin" class="nav-item">
                        <i class="bi bi-box-seam"></i> Đơn hàng
                    </a>
                </li>
                <li class="logout-link">
                    <a asp-controller="Auth" asp-action="Logout" class="nav-item logout-link">
                        <i class="bi bi-box-arrow-left"></i> Đăng xuất
                    </a>
                </li>
            </ul>
        </aside>

        <main class="main-wrapper">
            
            <header class="top-header">
                <form method="get" asp-action="Index" class="search-box">
                    <i class="bi bi-search text-muted"></i>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Tìm kiếm sách, tác giả...">
                    <button type="submit" class="d-none"></button>
                </form>
                
                <div class="profile-actions">

                    <img src="https://ui-avatars.com/api/?name=Admin&background=2b3445&color=fff" width="40" height="40" class="rounded-circle" alt="User">
                </div>
            </header>

            <div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold mb-0">Quản lý kho sách</h4>
                    <a asp-controller="Book" asp-action="Create" class="btn btn-custom-blue rounded-pill text-decoration-none">
                        <i class="bi bi-plus-lg me-1"></i> Thêm sách mới
                    </a>
                </div>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="admin-book-card mb-4 position-relative p-4">
                            <div class="d-flex align-items-start gap-4">
                                
                                <div class="book-cover-placeholder flex-shrink-0">
                                    @if (!string.IsNullOrEmpty(item.FileUrl))
                                    {
                                        <img src="@item.FileUrl" alt="Bìa sách" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-image fs-1"></i>
                                    }
                                </div>

                                <div class="flex-grow-1">
                                    <h5 class="fw-bold mb-3 pe-5" style="font-size: 1.2rem; color: var(--text-main);">@item.Title</h5>

                                    <div class="row w-100 mb-4">
                                        <div class="col-md-3 col-sm-6 mb-3">
                                            <div class="text-label">Tác giả</div>
                                            <div class="text-value">@item.Author</div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 mb-3">
                                            <div class="text-label">Thể loại</div>
                                            <div class="text-value">@item.Genre</div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 mb-3">
                                            <div class="text-label">Nhà xuất bản</div>
                                            <div class="text-value">@item.PublisherName</div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 mb-3">
                                            <div class="text-label">Số lượng</div>
                                            <div class="text-value">@item.Quantity</div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 mb-3">
                                            <div class="text-label">Ngày xuất bản</div>
                                            <div class="text-value">@item.PublicationDate.ToString("dd/MM/yyyy")</div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 mb-3">
                                            <div class="text-label">Giá bán</div>
                                            <div class="text-value text-primary fw-bold">@item.SellingPrice.ToString("N0") đ</div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 mb-3">
                                            <div class="text-label">Giá mua</div>
                                            <div class="text-value text-muted">@item.PurchasePrice.ToString("N0") đ</div>
                                        </div>
                                    </div>

                                    <a asp-controller="Book" asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-outline-primary btn-sm rounded-pill px-4 fw-bold">
                                        <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                                    </a>
                                </div>

                                <div class="position-absolute end-0 top-0 mt-4 me-4">
                                    <form asp-controller="Book" asp-action="Delete" asp-route-id="@item.BookId" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa cuốn sách này không?');">
                                        <button type="submit" class="btn-close-custom" title="Xóa sách">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </form>
                                </div>

                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 bg-white rounded shadow-sm" style="border-radius: 16px !important;">
                        <i class="bi bi-journal-x mb-3 d-block" style="font-size: 3rem; color: #cbd5e1;"></i>
                        <h5 class="fw-semibold text-dark">Chưa có dữ liệu sách</h5>
                        <p class="text-muted">Hãy bấm nút "Thêm sách mới" để cập nhật kho dữ liệu của bạn.</p>
                    </div>
                }

                @if (ViewBag.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="mt-4 mb-5">
                        <ul class="pagination justify-content-center">
                            
                            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-searchTerm="@ViewBag.SearchTerm">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                                </li>
                            }

                            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages || ViewBag.TotalPages == 0 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-searchTerm="@ViewBag.SearchTerm">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                            
                        </ul>
                    </nav>
                }

                <footer class="mt-auto pt-4 border-top" style="border-color: #e2e8f0 !important;">
                    <div class="text-muted" style="font-size: 0.85rem;">
                        Copyright © 2026. BookGate. All rights reserved.
                    </div>
                </footer>

            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>