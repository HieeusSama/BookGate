@model BookGate.Application.DTOs.BookDTO
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    bool isEdit = ViewBag.IsEdit ?? false;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Gate - @(isEdit ? "Chỉnh sửa sách" : "Thêm sách mới")</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --bg-color: #f4f7fc;
            --surface-color: #ffffff;
            --text-main: #1e1e2d;
            --text-muted: #8b92a5;
            --primary-color: #2b3445;
            --active-bg: #f1f3f9;
            --border-radius: 16px;
            --blue-accent: #009dff;
        }

        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: var(--bg-color); 
            color: var(--text-main); 
            overflow-x: hidden;
            margin: 0;
        }

        /* --- LAYOUT TỔNG --- */
        .app-wrapper { display: flex; min-height: 100vh; padding: 20px; gap: 24px; }

        /* --- SIDEBAR --- */
        .sidebar {
            width: 240px; background: var(--surface-color); border-radius: var(--border-radius);
            padding: 24px 16px; display: flex; flex-direction: column;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02); position: sticky; top: 20px; height: calc(100vh - 40px);
        }
        .brand-logo { display: flex; align-items: center; gap: 12px; font-size: 1.25rem; font-weight: 700; color: var(--text-main); text-decoration: none; margin-bottom: 40px; padding-left: 8px; }
        .brand-logo i { color: #f5b041; font-size: 1.5rem; }
        .nav-menu { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
        .nav-item { display: flex; align-items: center; gap: 16px; padding: 12px 16px; border-radius: 12px; color: var(--text-muted); text-decoration: none; font-weight: 500; transition: all 0.2s ease; }
        .nav-item.active { background-color: var(--active-bg); color: var(--text-main); font-weight: 600; }
        .nav-item:hover:not(.active) { color: var(--text-main); background-color: rgba(0,0,0,0.02); }
        .nav-item i { font-size: 1.2rem; }
        .logout-link { margin-top: auto; color: #e74c3c !important; }

        /* --- MAIN CONTENT & HEADER --- */
        .main-wrapper { flex: 1; display: flex; flex-direction: column; gap: 24px; }
        .top-header { background: var(--surface-color); border-radius: var(--border-radius); padding: 16px 24px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 20px rgba(0,0,0,0.02); }
        .profile-actions { display: flex; align-items: center; gap: 20px; }
        .icon-btn { width: 40px; height: 40px; border-radius: 50%; border: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: center; color: var(--text-main); text-decoration: none; font-size: 1.1rem; }

        /* --- FORM STYLES --- */
        .form-section {
            background: var(--surface-color);
            border-radius: var(--border-radius);
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        }

        .form-custom-control { 
            border-radius: 10px; 
            border: 1px solid #e2e8f0; 
            box-shadow: none; 
            background-color: #f8fafc;
            transition: all 0.2s;
        }
        .form-custom-control:focus { 
            border-color: var(--blue-accent); 
            background-color: #fff;
            box-shadow: 0 0 0 3px rgba(0, 157, 255, 0.1); 
        }
        .form-floating > label { font-weight: 500; color: #64748b; }
        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label { color: var(--blue-accent); }
        
        .input-validation-error { border-color: #ef4444 !important; }

        /* --- IMAGE UPLOADER (Chuẩn tỷ lệ bìa sách 2:3) --- */
        .book-cover-uploader {
            width: 100%;
            max-width: 260px;
            aspect-ratio: 2 / 3;
            background-color: #f8fafc;
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #94a3b8;
            overflow: hidden;
            margin-bottom: 20px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .book-cover-uploader:hover {
            border-color: var(--blue-accent);
            background-color: #f0f9ff;
            color: var(--blue-accent);
        }
        .book-cover-uploader i { font-size: 3.5rem; margin-bottom: 10px; }
        .book-cover-uploader img { width: 100%; height: 100%; object-fit: cover; }

        /* --- BUTTONS --- */
        .btn-custom-blue { background-color: var(--blue-accent); color: white; border-radius: 25px; padding: 10px 28px; font-weight: 500; border: none; transition: 0.2s; }
        .btn-custom-blue:hover { background-color: #0081d6; color: white; transform: translateY(-2px); }
        .btn-custom-gray { background-color: #e2e8f0; color: #475569; border-radius: 25px; padding: 10px 28px; font-weight: 500; border: none; transition: 0.2s; text-decoration: none; }
        .btn-custom-gray:hover { background-color: #cbd5e1; color: #1e293b; }
    </style>
</head>
<body>

    <div class="app-wrapper">
        
        <aside class="sidebar">
            <a asp-controller="Admin" asp-action="Index" class="brand-logo">
                <i class="bi bi-book-half"></i> Book Gate
            </a>
            
            <ul class="nav-menu">
                <li>
                    <a asp-controller="Admin" asp-action="Index" class="nav-item">
                        <i class="bi bi-house-door"></i> Tổng quan
                    </a>
                </li>
                <li>
                    <a asp-controller="Book" asp-action="Index" class="nav-item active">
                        <i class="bi bi-journal-text"></i> Quản lý sách
                    </a>
                </li>
                <li>
                    <a asp-controller="OrderStatus" asp-action="IndexAdmin" class="nav-item">
                        <i class="bi bi-box-seam"></i> Đơn hàng
                    </a>
                </li>
                <li class="logout-link">
                    <a asp-controller="Auth" asp-action="Logout" class="nav-item logout-link">
                        <i class="bi bi-box-arrow-left"></i> Đăng xuất
                    </a>
                </li>
            </ul>
        </aside>

        <main class="main-wrapper">
            
            <header class="top-header">
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Book" asp-action="Index" class="btn btn-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <h5 class="mb-0 fw-bold ms-2">@(isEdit ? "Chỉnh sửa sách" : "Thêm sách mới")</h5>
                </div>
                
                <div class="profile-actions ms-auto">

                    <img src="https://ui-avatars.com/api/?name=Admin&background=2b3445&color=fff" width="40" height="40" class="rounded-circle" alt="User">
                </div>
            </header>

            <div class="form-section">
                <form asp-controller="Book" asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-lg-8 pe-lg-5">
                            
                            @if (isEdit)
                            {
                                <div class="mb-3">
                                    <div class="form-floating">
                                        <input asp-for="BookId" class="form-control form-custom-control bg-light" placeholder="Mã sách" readonly>
                                        <label asp-for="BookId">Mã sách (ID)</label>
                                    </div>
                                </div>
                            }

                            <div class="mb-3">
                                <div class="form-floating">
                                    <input asp-for="Title" class="form-control form-custom-control" placeholder="Tên sách">
                                    <label asp-for="Title">Tên sách</label>
                                </div>
                                <span asp-validation-for="Title" class="text-danger small fw-bold mt-1 ms-1 d-block"></span>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <div class="form-floating">
                                        <input asp-for="Author" class="form-control form-custom-control" placeholder="Tác giả">
                                        <label asp-for="Author">Tác giả</label>
                                    </div>
                                    <span asp-validation-for="Author" class="text-danger small fw-bold mt-1 ms-1 d-block"></span>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <select asp-for="PublisherId" asp-items="ViewBag.PublisherList" class="form-select form-custom-control">
                                            <option value="">-- Chọn Nhà xuất bản --</option>
                                        </select>
                                        <label asp-for="PublisherId">Nhà xuất bản</label>
                                    </div>
                                    <span asp-validation-for="PublisherId" class="text-danger small fw-bold mt-1 ms-1 d-block"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <div class="form-floating">
                                        <input asp-for="PublicationDate" type="date" class="form-control form-custom-control">
                                        <label asp-for="PublicationDate">Ngày xuất bản</label>
                                    </div>
                                    <span asp-validation-for="PublicationDate" class="text-danger small fw-bold mt-1 ms-1 d-block"></span>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Genre" class="form-control form-custom-control" placeholder="Thể loại">
                                        <label asp-for="Genre">Thể loại</label>
                                    </div>
                                    <span asp-validation-for="Genre" class="text-danger small fw-bold mt-1 ms-1 d-block"></span>
                                </div>
                            </div>

                            <div class="row mb-4">
                                <div class="col-md-4 mb-3 mb-md-0">
                                    <div class="form-floating">
                                        <input asp-for="PurchasePrice" type="number" class="form-control form-custom-control" placeholder="Giá nhập">
                                        <label asp-for="PurchasePrice">Giá nhập (VNĐ)</label>
                                    </div>
                                    <span asp-validation-for="PurchasePrice" class="text-danger small fw-bold mt-1 ms-1 d-block"></span>
                                </div>
                                <div class="col-md-4 mb-3 mb-md-0">
                                    <div class="form-floating">
                                        <input asp-for="SellingPrice" type="number" class="form-control form-custom-control" placeholder="Giá bán">
                                        <label asp-for="SellingPrice">Giá bán (VNĐ)</label>
                                    </div>
                                    <span asp-validation-for="SellingPrice" class="text-danger small fw-bold mt-1 ms-1 d-block"></span>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating">
                                        <input asp-for="Quantity" type="number" class="form-control form-custom-control" placeholder="Số lượng">
                                        <label asp-for="Quantity">Số lượng nhập</label>
                                    </div>
                                    <span asp-validation-for="Quantity" class="text-danger small fw-bold mt-1 ms-1 d-block"></span>
                                </div>
                            </div>

                            <div class="d-flex gap-3 mt-5">
                                <button type="submit" class="btn btn-custom-blue">
                                    <i class="bi bi-floppy me-1"></i> @(isEdit ? "Lưu thay đổi" : "Lưu sách mới")
                                </button>
                                <a asp-controller="Book" asp-action="Index" class="btn btn-custom-gray">Hủy bỏ</a>
                            </div>
                        </div>

                        <div class="col-lg-4 d-flex flex-column align-items-center mt-4 mt-lg-0 border-start ps-lg-4">
                            <h6 class="fw-bold mb-3 w-100 text-center">Ảnh bìa sách</h6>
                            
                            <div class="book-cover-uploader" id="imagePreviewContainer" onclick="document.getElementById('coverImage').click()">
                                @if (isEdit && !string.IsNullOrEmpty(Model?.FileUrl))
                                {
                                    <img src="@Model.FileUrl" alt="Bìa sách" id="coverPreview" />
                                    <i class="bi bi-cloud-arrow-up d-none" id="coverPlaceholder"></i>
                                }
                                else
                                {
                                    <i class="bi bi-cloud-arrow-up" id="coverPlaceholder"></i>
                                    <span id="coverText" class="fw-medium">Tải ảnh lên</span>
                                    <img src="" alt="Bìa sách" id="coverPreview" class="d-none" />
                                }
                            </div>

                            <input type="file" name="coverImage" id="coverImage" accept="image/*" class="d-none" onchange="previewImage(event)">
                            <button type="button" class="btn btn-outline-primary rounded-pill px-4" onclick="document.getElementById('coverImage').click()">
                                Chọn ảnh khác
                            </button>

                            <small class="text-muted text-center mt-3" style="font-size: 0.8rem;">
                                Định dạng hỗ trợ: JPG, PNG.<br>Kích thước tối đa 2MB.<br>Tỷ lệ khuyên dùng 2:3.
                            </small>
                            <input type="hidden" asp-for="FileUrl" />
                        </div>
                    </div>
                </form>
            </div>

            <footer class="mt-auto pt-3 border-top" style="border-color: #e2e8f0 !important;">
                <div class="text-muted" style="font-size: 0.85rem;">
                    Copyright © 2026. BookGate. All rights reserved.
                </div>
            </footer>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function(){
                var output = document.getElementById('coverPreview');
                var placeholder = document.getElementById('coverPlaceholder');
                var text = document.getElementById('coverText');
                
                output.src = reader.result;
                output.classList.remove('d-none');
                
                if(placeholder) placeholder.classList.add('d-none');
                if(text) text.classList.add('d-none');
            };
            if(event.target.files[0]) {
                reader.readAsDataURL(event.target.files[0]);
            }
        }
    </script>
</body>
</html>