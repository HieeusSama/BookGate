@model BookGate.Application.DTOs.OrderDTO
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    // Lấy tổng tiền đã tính toán từ Controller
    decimal totalAmount = ViewBag.TotalAmount ?? 0;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Gate - Địa chỉ giao hàng</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #ffffff;
            color: #1e272e;
        }

        /* HEADER GIỐNG TRANG GIỎ HÀNG */
        .navbar-custom {
            padding: 20px 0;
            background-color: #fff;
        }

        .search-box {
            color: #808e9b;
            font-size: 0.95rem;
            cursor: text;
        }

        .brand-logo {
            font-weight: 800;
            font-size: 1.25rem;
            letter-spacing: 0.5px;
            color: #000;
            text-decoration: none;
        }

        .user-action {
            display: flex;
            align-items: center;
            gap: 15px;
            color: #1e272e;
            font-size: 0.95rem;
            font-weight: 500;
        }

        /* FORM STYLE */
        .form-label-custom {
            font-size: 0.9rem;
            font-weight: 500;
            color: #2d3436;
        }

        .form-control-custom {
            border: 1px solid #dee2e6;
            border-radius: 50px; /* Bo tròn pill dạng thiết kế */
            padding: 12px 25px;
            font-size: 0.95rem;
            color: #2d3436;
            background-color: #fff;
            transition: all 0.2s;
        }

            .form-control-custom:focus {
                box-shadow: none;
                border-color: #0099ff;
                background-color: #f8f9fa;
            }

        .btn-checkout {
            background-color: #0099ff;
            color: white;
            font-weight: 600;
            border-radius: 8px;
            padding: 12px 40px;
            border: none;
            transition: all 0.2s;
        }

            .btn-checkout:hover {
                background-color: #0081d6;
                color: white;
                transform: translateY(-1px);
            }

        .payment-info-box {
            border-top: 1px solid #f1f2f6;
            padding-top: 30px;
        }

        /* FOOTER GIỐNG TRANG GIỎ HÀNG */
        footer {
            margin-top: 80px;
            padding: 60px 0 30px;
            border-top: 1px solid #f1f2f6;
        }

        .footer-title {
            font-weight: 700;
            color: #ff7675;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        .footer-links {
            list-style: none;
            padding: 0;
        }

            .footer-links li {
                margin-bottom: 12px;
            }

            .footer-links a {
                color: #1e272e;
                text-decoration: none;
                font-size: 0.9rem;
            }

                .footer-links a:hover {
                    color: #ff7675;
                }
    </style>
</head>
<body>
    <div class="container">
        <header class="navbar-custom d-flex justify-content-between align-items-center">
            <div class="search-box d-flex align-items-center gap-2">
                <i class="bi bi-search fs-5"></i>
                <span class="d-none d-md-inline">Tìm kiếm sách, tác giả...</span>
            </div>

            <a href="/" class="brand-logo">Book Gate</a>

            <div class="user-action">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-circle fs-4"></i>
                    <span class="d-none d-md-inline">Chào, @User.Identity!.Name</span>
                </div>
                <a asp-controller="CartItem" asp-action="Index" class="text-dark">
                    <i class="bi bi-bag fs-5 ms-3"></i>
                </a>
            </div>
        </header>

        <div class="mt-5 mb-5 mx-auto" style="max-width: 850px;">
            <h4 class="mb-5 fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 1.1rem;">ĐỊA CHỈ GIAO HÀNG</h4>

            <form asp-controller="Order" asp-action="CheckOut" method="post">
                @* Hidden fields nếu cần thiết *@
                <input type="hidden" name="TotalAmount" value="@totalAmount" />

                <div class="row mb-4 align-items-center">
                    <div class="col-md-3">
                        <label class="form-label-custom">Họ và tên người nhận</label>
                    </div>
                    <div class="col-md-9">
                        <input type="text" class="form-control form-control-custom shadow-none" name="FullName" placeholder="Nhập họ tên..." required>
                    </div>
                </div>

                <div class="row mb-4 align-items-center">
                    <div class="col-md-3">
                        <label class="form-label-custom">Số điện thoại</label>
                    </div>
                    <div class="col-md-9">
                        <input type="tel" class="form-control form-control-custom shadow-none" name="ReceiverPhone" placeholder="Nhập số điện thoại..." required>
                    </div>
                </div>

                <div class="row mb-4 align-items-center">
                    <div class="col-md-3">
                        <label class="form-label-custom">Tỉnh/Thành Phố</label>
                    </div>
                    <div class="col-md-9">
                        <input type="text" class="form-control form-control-custom shadow-none" name="City" placeholder="Ví dụ: Hà Nội" required>
                    </div>
                </div>

                <div class="row mb-4 align-items-center">
                    <div class="col-md-3">
                        <label class="form-label-custom">Phường/Xã</label>
                    </div>
                    <div class="col-md-9">
                        <input type="text" class="form-control form-control-custom shadow-none" name="Ward" placeholder="Nhập phường/xã..." required>
                    </div>
                </div>

                <div class="row mb-5 align-items-center">
                    <div class="col-md-3">
                        <label class="form-label-custom">Địa chỉ nhận hàng</label>
                    </div>
                    <div class="col-md-9">
                        <input type="text" class="form-control form-control-custom shadow-none" name="StreetAddress" placeholder="Số nhà, tên đường..." required>
                    </div>
                </div>

                <div class="payment-info-box d-flex justify-content-between align-items-end mt-4">
                    <div class="d-flex align-items-center gap-4">
                        <span class="fw-bold" style="font-size: 0.95rem;">Tổng Số Tiền <span class="fw-normal text-muted ms-1">(gồm VAT)</span></span>
                        <span class="text-danger fw-bold fs-4">@totalAmount.ToString("N0") đ</span>
                    </div>

                    <div class="text-end">
                        <div class="mb-2 text-muted" style="font-size: 0.85rem;">
                            <i class="bi bi-check2-circle text-success me-1"></i> Thanh toán khi nhận hàng
                        </div>
                        <button type="submit" class="btn btn-checkout shadow-sm">
                            Xác nhận thanh toán
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <footer>
            <div class="row g-4">
                <div class="col-lg-4 pe-lg-5 mb-4 mb-lg-0">
                    <div class="footer-logo mb-3"><i class="bi bi-book"></i></div>
                    <p class="text-muted" style="font-size: 0.85rem; line-height: 1.6;">
                        Book Gate là nền tảng đọc sách trực tuyến hàng đầu, mang đến cho bạn không gian khám phá tri thức vô tận.
                    </p>
                </div>
                <div class="col-lg-2 d-none d-lg-block"></div>
                <div class="col-6 col-lg-2">
                    <h6 class="footer-title">Khám phá</h6>
                    <ul class="footer-links">
                        <li><a href="#">Về chúng tôi</a></li>
                        <li><a href="#">Blog</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="footer-title">Trợ giúp</h6>
                    <ul class="footer-links">
                        <li><a href="#">Hỗ trợ</a></li>
                        <li><a href="#">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-12 col-lg-2 mt-4 mt-lg-0">
                    <h6 class="footer-title">Theo dõi</h6>
                    <ul class="footer-links">
                        <li><a href="#"><i class="bi bi-facebook me-2"></i> Facebook</a></li>
                        <li><a href="#"><i class="bi bi-instagram me-2"></i> Instagram</a></li>
                    </ul>
                </div>
            </div>
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-5 pt-4 border-top" style="font-size: 0.8rem; color: #a4b0be;">
                <p class="mb-2 mb-md-0">Copyright © 2026 BookGate. All rights reserved.</p>
                <div class="d-flex gap-3">
                    <a href="#" class="text-decoration-none text-muted">Điều khoản</a>
                    <a href="#" class="text-decoration-none text-muted">Bảo mật</a>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>