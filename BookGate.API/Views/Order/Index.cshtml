@model BookGate.Application.DTOs.OrderDTO
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    decimal totalAmount = ViewBag.TotalAmount ?? 0;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Gate - Địa chỉ giao hàng</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #ffffff;
            color: #1e272e;
        }

        .navbar-custom {
            padding: 20px 0;
            background-color: #fff;
        }

        .search-box {
            color: #808e9b;
            font-size: 0.95rem;
            cursor: text;
        }

        .brand-logo {
            font-weight: 800;
            font-size: 1.25rem;
            letter-spacing: 0.5px;
            color: #000;
            text-decoration: none;
        }

        .user-action {
            display: flex;
            align-items: center;
            gap: 15px;
            color: #1e272e;
            font-size: 0.95rem;
            font-weight: 500;
        }

        /* FORM STYLE */
        .form-label-custom {
            font-size: 0.9rem;
            font-weight: 500;
            color: #2d3436;
        }

        .form-control-custom {
            border: 1px solid #dee2e6;
            border-radius: 50px;
            padding: 12px 25px;
            font-size: 0.95rem;
            color: #2d3436;
            background-color: #fff;
            transition: all 0.2s;
        }

            .form-control-custom:focus {
                box-shadow: none;
                border-color: #0099ff;
                background-color: #f8f9fa;
            }

        .btn-checkout {
            background-color: #0099ff;
            color: white;
            font-weight: 600;
            border-radius: 8px;
            padding: 12px 40px;
            border: none;
            transition: all 0.2s;
        }

            .btn-checkout:hover {
                background-color: #0081d6;
                color: white;
                transform: translateY(-1px);
            }

        .payment-info-box {
            border-top: 1px solid #f1f2f6;
            padding-top: 30px;
        }

        /* FOOTER GIỐNG TRANG GIỎ HÀNG */
        footer {
            margin-top: 80px;
            padding: 60px 0 30px;
            border-top: 1px solid #f1f2f6;
        }

        .footer-title {
            font-weight: 700;
            color: #ff7675;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        .footer-links {
            list-style: none;
            padding: 0;
        }

            .footer-links li {
                margin-bottom: 12px;
            }

            .footer-links a {
                color: #1e272e;
                text-decoration: none;
                font-size: 0.9rem;
            }

                .footer-links a:hover {
                    color: #ff7675;
                }
    </style>
</head>
<body>
    <div class="container">
        <partial name="_Header" />

        <div class="mt-5 mb-5 mx-auto" style="max-width: 850px;">
            <h4 class="mb-5 fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 1.1rem;">ĐỊA CHỈ GIAO HÀNG</h4>

            <form asp-controller="Order" asp-action="CheckOut" method="post">

                <input type="hidden" name="bookId" value="@ViewBag.BookId" />
                <input type="hidden" name="quantity" value="@ViewBag.Quantity" />
                <input type="hidden" name="TotalAmount" value="@totalAmount" />

                <div class="row mb-4 align-items-center">
                    <div class="col-md-3">
                        <label class="form-label-custom">Số điện thoại <span class="text-danger">*</span></label>
                    </div>

                    <div class="col-md-9">
                        <input asp-for="ReceiverPhone"
                               class="form-control form-control-custom shadow-none"
                               placeholder="Ví dụ: 0912345678"
                               pattern="0[0-9]{9}"
                               maxlength="10"
                               oninput="this.value=this.value.replace(/[^0-9]/g,'')" />

                        <span asp-validation-for="ReceiverPhone" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-4 align-items-center">
                    <div class="col-md-3"><label class="form-label-custom">Tỉnh/Thành Phố</label></div>
                    <div class="col-md-9">
                        <select class="form-select form-control-custom shadow-none" id="provinceSelect" required>
                            <option value="">-- Chọn Tỉnh/Thành --</option>
                        </select>
                        <input asp-for="City" type="hidden" id="hiddenCity" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-4 align-items-center">
                    <div class="col-md-3"><label class="form-label-custom">Quận/Huyện</label></div>
                    <div class="col-md-9">
                        <select class="form-select form-control-custom shadow-none" id="districtSelect" required disabled>
                            <option value="">-- Chọn Quận/Huyện --</option>
                        </select>
                        <input asp-for="District" type="hidden" id="hiddenDistrict" />
                        <span asp-validation-for="District" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-4 align-items-center">
                    <div class="col-md-3"><label class="form-label-custom">Phường/Xã</label></div>
                    <div class="col-md-9">
                        <select class="form-select form-control-custom shadow-none" id="wardSelect" required disabled>
                            <option value="">-- Chọn Phường/Xã --</option>
                        </select>
                        <input asp-for="Ward" type="hidden" id="hiddenWard" />
                        <span asp-validation-for="Ward" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-5 align-items-center">
                    <div class="col-md-3">
                        <label class="form-label-custom">Địa chỉ nhận hàng</label>
                    </div>
                    <div class="col-md-9">
                        <input asp-for="StreetAddress"
                               class="form-control form-control-custom shadow-none"
                               placeholder="Số nhà, tên đường..." />

                        <span asp-validation-for="StreetAddress"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-4 mb-3">
                    <span class="fw-bold" style="font-size: 0.95rem;">Tạm tính sách: <span id="subTotalDisplay">@(totalAmount.ToString("N0"))</span> đ</span>
                </div>
                <div class="d-flex align-items-center gap-4 mb-3 text-primary">
                    <span class="fw-bold" style="font-size: 0.95rem;">Phí vận chuyển (GHN): <span id="shippingFeeDisplay">0</span> đ</span>
                </div>
                <div class="d-flex align-items-center gap-4 mb-3">
                    <span class="fw-bold" style="font-size: 0.95rem;">Tổng Số Tiền <span class="fw-normal text-muted ms-1">(gồm VAT)</span></span>
                    <span class="text-danger fw-bold fs-4" id="totalAmountDisplay">@(totalAmount.ToString("N0")) đ</span>
                </div>

                <div class="payment-info-box d-flex justify-content-between align-items-end mt-4">
    
                    <div>
                        <label class="form-label-custom d-block mb-3 fw-bold">Phương thức thanh toán:</label>
        
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="PaymentMethod" id="cod" value="COD" checked>
                            <label class="form-check-label" for="cod">Thanh toán khi nhận hàng</label>
                        </div>
        
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="PaymentMethod" id="vnpay" value="VNPAY">
                            <label class="form-check-label" for="vnpay">
                                Thanh toán bằng
                                <img src="https://vnpay.vn/s1/statics.vnpay.vn/2023/6/0oxhzjmxbksr1686814746087.png" alt="VNPAY" style="height: 24px; margin-left: 5px;" />
                            </label>
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-checkout shadow-sm">
                            Xác nhận đặt hàng
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <footer>
            <div class="row g-4">
                <div class="col-lg-4 pe-lg-5 mb-4 mb-lg-0">
                    <div class="footer-logo mb-3"><i class="bi bi-book"></i></div>
                    <p class="text-muted" style="font-size: 0.85rem; line-height: 1.6;">
                        Book Gate là nền tảng đọc sách trực tuyến hàng đầu, mang đến cho bạn không gian khám phá tri thức vô tận.
                    </p>
                </div>
                <div class="col-lg-2 d-none d-lg-block"></div>
                <div class="col-6 col-lg-2">
                    <h6 class="footer-title">Khám phá</h6>
                    <ul class="footer-links">
                        <li><a href="#">Về chúng tôi</a></li>
                        <li><a href="#">Blog</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="footer-title">Trợ giúp</h6>
                    <ul class="footer-links">
                        <li><a href="#">Hỗ trợ</a></li>
                        <li><a href="#">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-12 col-lg-2 mt-lg-0">
                    <h6 class="footer-title">Theo dõi</h6>
                    <ul class="footer-links">
                        <li><a href="#"><i class="bi bi-facebook me-2"></i> Facebook</a></li>
                        <li><a href="#"><i class="bi bi-instagram me-2"></i> Instagram</a></li>
                    </ul>
                </div>
            </div>
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-5 pt-4 border-top" style="font-size: 0.8rem; color: #a4b0be;">
                <p class="mb-2 mb-md-0">Copyright © 2026 BookGate. All rights reserved.</p>
                <div class="d-flex gap-3">
                    <a href="#" class="text-decoration-none text-muted">Điều khoản</a>
                    <a href="#" class="text-decoration-none text-muted">Bảo mật</a>
                </div>
            </div>
        </footer>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    $.validator.setDefaults({ ignore: "" });

    document.addEventListener("DOMContentLoaded", function () {
        const provinceSelect = document.getElementById("provinceSelect");
        const districtSelect = document.getElementById("districtSelect");
        const wardSelect = document.getElementById("wardSelect");
        
        const hiddenCity = document.getElementById("hiddenCity");
        const hiddenDistrict = document.getElementById("hiddenDistrict");
        const hiddenWard = document.getElementById("hiddenWard");
        
        const shippingFeeDisplay = document.getElementById("shippingFeeDisplay");
        const totalAmountDisplay = document.getElementById("totalAmountDisplay");
        const inputTotalAmount = document.querySelector('input[name="TotalAmount"]'); //
        
        const subTotal = parseFloat(inputTotalAmount.value);
        
        const quantity = @(ViewBag.Quantity ?? 1);
        fetch('@Url.Action("GetProvinces", "Order")')
            .then(res => res.json())
            .then(data => {
                if (data.code === 200) {
                    data.data.forEach(p => {
                        provinceSelect.innerHTML += `<option value="${p.ProvinceID}">${p.ProvinceName}</option>`;
                    });
                }
            });

        // 2. Khi chọn Tỉnh -> Tải Quận/Huyện
        provinceSelect.addEventListener("change", function () {
            hiddenCity.value = this.options[this.selectedIndex].text;
            $(hiddenCity).valid(); // Xóa lỗi đỏ khi đã chọn Tỉnh

            districtSelect.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
            wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
            districtSelect.disabled = true;
            wardSelect.disabled = true;

            if (this.value) {
                fetch(`@Url.Action("GetDistricts", "Order")?provinceId=${this.value}`)
                    .then(res => res.json())
                    .then(data => {
                        if (data.code === 200) {
                            data.data.forEach(d => {
                                districtSelect.innerHTML += `<option value="${d.DistrictID}">${d.DistrictName}</option>`;
                            });
                            districtSelect.disabled = false;
                        }
                    });
            }
        });

        // 3. Khi chọn Huyện -> Tải Phường/Xã
        districtSelect.addEventListener("change", function () {
            // Lưu tên Quận/Huyện để gửi về Database
            if (hiddenDistrict) {
                hiddenDistrict.value = this.options[this.selectedIndex].text;
                $(hiddenDistrict).valid();
            }

            wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
            wardSelect.disabled = true;

            if (this.value) {
                fetch(`@Url.Action("GetWards", "Order")?districtId=${this.value}`)
                    .then(res => res.json())
                    .then(data => {
                        if (data.code === 200) {
                            data.data.forEach(w => {
                                wardSelect.innerHTML += `<option value="${w.WardCode}">${w.WardName}</option>`;
                            });
                            wardSelect.disabled = false;
                        }
                    });
            }
        });

        // 4. Khi chọn Phường/Xã -> GỌI API GHN TÍNH PHÍ SHIP
        wardSelect.addEventListener("change", function () {
            const wardText = this.options[this.selectedIndex].text;
            hiddenWard.value = wardText; // Chỉ lưu tên Phường
            $(hiddenWard).valid(); // Xóa lỗi đỏ khi đã chọn Xã

            const districtId = districtSelect.value;
            const wardCode = this.value;

            if (districtId && wardCode) {
                // Hiển thị trạng thái đang tính
                shippingFeeDisplay.innerText = "Đang tính...";
                
                fetch(`@Url.Action("CalculateFee", "Order")?districtId=${districtId}&wardCode=${wardCode}&quantity=${quantity}`)
                    .then(res => res.json())
                    .then(data => {
                        const fee = data.fee;
                        const finalTotal = subTotal + fee;

                        // Cập nhật lên màn hình
                        shippingFeeDisplay.innerText = fee.toLocaleString('vi-VN');
                        totalAmountDisplay.innerText = finalTotal.toLocaleString('vi-VN') + " đ";
                        
                        // Cập nhật vào thẻ input ẩn để gửi về Form Post
                        inputTotalAmount.value = finalTotal;
                    });
            }
        });
    });
</script>
</body>
</html>