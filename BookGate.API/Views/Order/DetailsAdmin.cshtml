@model IEnumerable<BookGate.Application.DTOs.OrderDetailDTO>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    var orderDate = ViewBag.OrderDate;
    decimal shippingFee = Convert.ToDecimal(ViewBag.ShippingFee ?? 0);
    decimal subTotal = Model?.Sum(x => x.UnitPrice * x.Quantity) ?? 0;
    decimal totalAmount = subTotal + shippingFee;
    string PaymentMethod = ViewBag.PaymentMethod ?? "Thanh toán khi nhận hàng (COD)";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Gate - Chi tiết đơn hàng</title>

    <link href="https://fonts.googleapis.com/css2?family=Segoe+UI:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --bg-color: #f4f7fc;
            --surface-color: #ffffff;
            --text-main: #1e1e2d;
            --text-muted: #8b92a5;
            --primary-color: #2b3445;
            --active-bg: #f1f3f9;
            --border-radius: 16px;
            --blue-accent: #009dff;
        }

        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: var(--bg-color); 
            color: var(--text-main); 
            overflow-x: hidden;
            margin: 0;
        }

        /* --- LAYOUT TỔNG --- */
        .app-wrapper { display: flex; min-height: 100vh; padding: 20px; gap: 24px; }

        /* --- SIDEBAR --- */
        .sidebar {
            width: 240px; background: var(--surface-color); border-radius: var(--border-radius);
            padding: 24px 16px; display: flex; flex-direction: column;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02); position: sticky; top: 20px; height: calc(100vh - 40px);
        }
        .brand-logo { display: flex; align-items: center; gap: 12px; font-size: 1.25rem; font-weight: 700; color: var(--text-main); text-decoration: none; margin-bottom: 40px; padding-left: 8px; }
        .brand-logo i { color: #f5b041; font-size: 1.5rem; }
        .nav-menu { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
        .nav-item { display: flex; align-items: center; gap: 16px; padding: 12px 16px; border-radius: 12px; color: var(--text-muted); text-decoration: none; font-weight: 500; transition: all 0.2s ease; }
        .nav-item.active { background-color: var(--active-bg); color: var(--text-main); font-weight: 600; }
        .nav-item:hover:not(.active) { color: var(--text-main); background-color: rgba(0,0,0,0.02); }
        .nav-item i { font-size: 1.2rem; }
        .logout-link { margin-top: auto; color: #e74c3c !important; }

        /* --- MAIN CONTENT & HEADER --- */
        .main-wrapper { flex: 1; display: flex; flex-direction: column; gap: 24px; }
        .top-header { background: var(--surface-color); border-radius: var(--border-radius); padding: 16px 24px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 20px rgba(0,0,0,0.02); }
        .profile-actions { display: flex; align-items: center; gap: 20px; }
        .icon-btn { width: 40px; height: 40px; border-radius: 50%; border: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: center; color: var(--text-main); text-decoration: none; font-size: 1.1rem; }

        /* --- THIẾT KẾ CHI TIẾT ĐƠN HÀNG --- */
        .detail-card {
            background: var(--surface-color);
            border-radius: var(--border-radius);
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
            margin-bottom: 24px;
        }

        .card-title-custom {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid #f1f5f9;
        }

        /* Dòng Sản Phẩm */
        .item-row { display: flex; align-items: center; padding: 16px 0; border-bottom: 1px dashed #e2e8f0; }
        .item-row:last-child { border-bottom: none; padding-bottom: 0; }
        
        .item-image { 
            width: 70px; height: 105px; 
            background-color: #f8fafc; 
            border-radius: 8px; 
            display: flex; align-items: center; justify-content: center; 
            overflow: hidden; flex-shrink: 0;
            border: 1px solid #f1f5f9;
        }
        .item-image img { width: 100%; height: 100%; object-fit: cover; }
        .item-info { flex-grow: 1; padding: 0 20px; }
        .item-title { font-weight: 600; font-size: 0.95rem; margin-bottom: 4px; color: var(--text-main); }
        .item-qty { font-size: 0.9rem; font-weight: 500; color: #64748b; background: #f8fafc; padding: 4px 12px; border-radius: 50px; }
        .item-price { font-weight: 600; color: #ef4444; font-size: 1rem; }

        /* Khối Tóm tắt thanh toán */
        .summary-row { display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 0.95rem; color: #475569; }
        .summary-row span:last-child { font-weight: 500; color: var(--text-main); }
        .summary-total { 
            display: flex; justify-content: space-between; align-items: center;
            margin-top: 16px; padding-top: 16px; border-top: 1px solid #e2e8f0; 
            font-weight: 700; font-size: 1.1rem; color: var(--text-main); 
        }
        .text-custom-red { color: #ef4444; font-size: 1.25rem; }

        .info-label { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 4px; }
        .info-value { font-size: 0.95rem; font-weight: 600; color: var(--text-main); }
    </style>
</head>
<body>

    <div class="app-wrapper">
        
        <aside class="sidebar">
            <a asp-controller="Admin" asp-action="Index" class="brand-logo">
                <i class="bi bi-book-half"></i> Book Gate
            </a>
            
            <ul class="nav-menu">
                <li>
                    <a asp-controller="Admin" asp-action="Index" class="nav-item">
                        <i class="bi bi-house-door"></i> Tổng quan
                    </a>
                </li>
                <li>
                    <a asp-controller="Book" asp-action="Index" class="nav-item">
                        <i class="bi bi-journal-text"></i> Quản lý sách
                    </a>
                </li>
                <li>
                    <a asp-controller="OrderStatus" asp-action="IndexAdmin" class="nav-item active">
                        <i class="bi bi-box-seam"></i> Đơn hàng
                    </a>
                </li>
                <li class="logout-link">
                    <a asp-controller="Auth" asp-action="Logout" class="nav-item logout-link">
                        <i class="bi bi-box-arrow-left"></i> Đăng xuất
                    </a>
                </li>
            </ul>
        </aside>

        <main class="main-wrapper">
            
            <header class="top-header">
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="OrderStatus" asp-action="IndexAdmin" class="btn btn-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <h5 class="mb-0 fw-bold ms-2">Chi tiết đơn hàng</h5>
                </div>
                
                <div class="profile-actions ms-auto">

                    <img src="https://ui-avatars.com/api/?name=Admin&background=2b3445&color=fff" width="40" height="40" class="rounded-circle" alt="User">
                </div>
            </header>

            <div>
                <div class="row gx-4">
                    
                    <div class="col-lg-8">
                        <div class="detail-card">
                            <div class="card-title-custom">Danh sách sản phẩm</div>
                            
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <div class="item-row">
                                        <div class="item-image">
                                            @if (!string.IsNullOrEmpty(item.FileUrl))
                                            {
                                                <img src="@item.FileUrl" alt="@item.Title" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-image text-muted fs-3"></i>
                                            }
                                        </div>
                                        <div class="item-info">
                                            <div class="item-title">@item.Title</div>
                                            <div class="info-label mt-1">Đơn giá: @item.UnitPrice.ToString("N0") đ</div>
                                        </div>
                                        <div class="text-center px-4">
                                            <div class="item-qty">SL: @item.Quantity</div>
                                        </div>
                                        <div class="text-end" style="min-width: 120px;">
                                            <div class="item-price">@((item.UnitPrice * item.Quantity).ToString("N0")) đ</div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Không tìm thấy chi tiết sản phẩm.
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="detail-card">
                            <div class="card-title-custom">Thông tin thanh toán</div>
                            
                            <div class="mb-4">
                                <div class="info-label">Ngày đặt hàng</div>
                                <div class="info-value">@orderDate</div>
                            </div>
                            
                            <div class="summary-row">
                                <span>Tạm tính</span>
                                <span>@subTotal.ToString("N0") đ</span>
                            </div>
                            <div class="summary-row">
                                <span>Phí vận chuyển</span>
                                <span>@shippingFee.ToString("N0") đ</span>
                            </div>
                            <div class="summary-row">
                                <span>Phương thức</span>
                                <span class="text-end" style="max-width: 60%;">@PaymentMethod</span>
                            </div>

                            <div class="summary-total">
                                <span>Tổng cộng</span>
                                <span class="text-custom-red">@totalAmount.ToString("N0") đ</span>
                            </div>
                        </div>

                        </div>

                </div>
            </div>

            <footer class="mt-auto pt-4 border-top" style="border-color: #e2e8f0 !important;">
                <div class="text-muted" style="font-size: 0.85rem;">
                    Copyright © 2026. BookGate. All rights reserved.
                </div>
            </footer>

        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>