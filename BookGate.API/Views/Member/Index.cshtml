@model IEnumerable<BookGate.Application.DTOs.MemberBookDTO>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Gate - Trang chủ</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #ffffff; color: #1e272e; }
        .navbar-custom { padding: 20px 0; background-color: #fff; }
        .brand-logo { font-weight: 800; font-size: 1.25rem; letter-spacing: 0.5px; color: #000; text-decoration: none; }
        .user-action { display: flex; align-items: center; gap: 15px; color: #1e272e; font-size: 0.95rem; font-weight: 500; }
        .hero-banner { background-color: #e2e8f0; height: 280px; border-radius: 4px; display: flex; align-items: center; justify-content: center; margin-bottom: 50px; margin-top: 10px; }
        .section-header { display: flex; align-items: baseline; margin-bottom: 20px; }
        .section-header h5 { font-weight: 700; font-size: 1rem; text-transform: uppercase; margin-bottom: 0; letter-spacing: 0.5px; }
        .section-header small { color: #808e9b; margin-left: 8px; font-size: 0.85rem; }
        
        /* Book Card */
        .book-card { padding: 10px; border-radius: 8px; border: 1px solid transparent; transition: all 0.2s ease; background: #fff; }
        .book-card:hover { border-color: #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.05); transform: translateY(-3px); }
        .book-item { text-decoration: none; color: inherit; display: block; }
        .btn-favorite { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border: none; z-index: 10; cursor: pointer; transition: all 0.2s; }
        .btn-favorite:hover { transform: scale(1.1); }
        .btn-favorite .bi-heart-fill { display: none; }
        .btn-favorite:hover .bi-heart { display: none; }
        .btn-favorite:hover .bi-heart-fill { display: inline-block; }
        .book-cover { background-color: #e2e8f0; aspect-ratio: 3/4; border-radius: 4px; display: flex; align-items: center; justify-content: center; margin-bottom: 12px; overflow: hidden; }
        .book-cover i { font-size: 2.5rem; color: #cbd5e1; }
        .book-title { font-weight: 600; font-size: 0.95rem; line-height: 1.4; margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .book-author { color: #64748b; font-size: 0.8rem; }
        .book-publisher { color: #a4b0be; font-size: 0.75rem; margin-bottom: 4px; }
        
        /* Nút Mua */
        .btn-buy { font-size: 0.85rem; font-weight: 600; background-color: #009dff; color: white; border: none; padding: 8px; border-radius: 6px; transition: background-color 0.2s; }
        .btn-buy:hover { background-color: #0081d6; color: white; }

        /* Nút search form mới */
        .search-form-container { background: #f8f9fa; border-radius: 50px; padding: 5px 20px; border: 1px solid #e2e8f0; }
        .search-form-container input:focus { box-shadow: none; outline: none; }

        /* ================= CHAT BOT CSS ================= */
        .chat-btn { position: fixed; bottom: 30px; right: 30px; width: 60px; height: 60px; border-radius: 50%; background: #009dff; color: white; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.2); font-size: 24px; cursor: pointer; z-index: 1000; transition: transform 0.2s;}
        .chat-btn:hover { transform: scale(1.1); }
        .chat-window { position: fixed; bottom: 100px; right: 30px; width: 350px; height: 450px; background: white; border-radius: 12px; box-shadow: 0 5px 25px rgba(0,0,0,0.2); display: none; flex-direction: column; z-index: 1000; overflow: hidden; border: 1px solid #e2e8f0; }
        .chat-header { background: #009dff; color: white; padding: 15px; font-weight: bold; display: flex; justify-content: space-between; align-items: center; }
        .chat-body { flex: 1; padding: 15px; overflow-y: auto; background: #f8f9fa; display: flex; flex-direction: column; gap: 10px; }
        .chat-input-area { padding: 10px; background: white; border-top: 1px solid #e2e8f0; display: flex; gap: 10px; align-items: center; }
        .chat-input-area input { flex: 1; border: 1px solid #dee2e6; border-radius: 20px; padding: 8px 15px; outline: none; }
        .chat-input-area button { background: #009dff; color: white; border: none; border-radius: 50%; width: 40px; height: 40px; display: flex; justify-content: center; align-items: center; }
    
        .msg { max-width: 80%; padding: 10px 15px; border-radius: 15px; font-size: 0.9rem; line-height: 1.4; word-wrap: break-word;}
        .msg-ai { background: #e2e8f0; color: #1e272e; align-self: flex-start; border-bottom-left-radius: 2px;}
        .msg-user { background: #009dff; color: white; align-self: flex-end; border-bottom-right-radius: 2px;}

        /* Footer */
        footer { margin-top: 80px; padding: 60px 0 30px; border-top: 1px solid #f1f2f6; }
        .footer-logo i { font-size: 2rem; color: #1e272e; }
        .footer-title { font-weight: 700; color: #ff7675; margin-bottom: 1.5rem; font-size: 0.9rem; text-transform: uppercase; }
        .footer-links { list-style: none; padding: 0; margin: 0; }
        .footer-links li { margin-bottom: 12px; }
        .footer-links a { color: #1e272e; text-decoration: none; font-size: 0.9rem; }
        .footer-links a:hover { color: #ff7675; }
        .hero-banner { 
            background-color: #e2e8f0; 
            height: 200px; 
            border-radius: 8px; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            margin-bottom: 30px; 
            margin-top: 10px; 
            overflow: hidden; 
        }
    </style>
</head>
<body>
    <div class="container">
        <partial name="_Header" />

        <div class="hero-banner">
            <img src="/uploads/banner/banner.png" alt="Main Banner" style="width: 100%; height: auto;">
        </div>

        <section class="mb-5">
            <div class="section-header">
                @if (!string.IsNullOrEmpty(ViewBag.SearchString))
                {
                    <h5>KẾT QUẢ TÌM KIẾM</h5>
                    <small>Từ khóa: "@ViewBag.SearchString"</small>
                }
                else
                {
                    <h5>TẤT CẢ SÁCH</h5>
                    <small>(Cập nhật mới nhất)</small>
                }
            </div>

            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3 g-md-4">
                @if (Model != null && Model.Any())
                {
                    foreach (var book in Model)
                    {
                        <div class="col">
                            <div class="book-card position-relative h-100 d-flex flex-column">

                                <a asp-controller="Member" asp-action="Details" asp-route-bookId="@book.BookId" class="book-item flex-grow-1">
                                    <div class="book-cover">
                                        @if (!string.IsNullOrEmpty(book.FileUrl))
                                        {
                                            <img src="@book.FileUrl" alt="@book.Title" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-image"></i>
                                        }
                                    </div>

                                    <div class="book-title" title="@book.Title">@book.Title</div>
                                    <div class="book-author">@book.Author</div>
                                    <div class="text-danger fw-bold mt-1 fs-6">@book.SellingPrice.ToString("N0") đ</div>
                                    
                                </a>
                                <a asp-controller="Member" asp-action="CreateCartItem" asp-route-bookId="@book.BookId" class="btn-buy w-100 mt-3 d-flex justify-content-center align-items-center gap-2 text-decoration-none">
                                        <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="d-flex flex-column align-items-center justify-content-center py-5 my-5 w-100 text-center">
                        <i class="bi bi-journal-x fs-1 text-muted"></i>
                        <p class="text-muted mt-2">Không tìm thấy sách nào phù hợp.</p>
                        <a href="@Url.Action("Index", "Member")" class="btn btn-outline-secondary mt-2">Quay lại</a>
                    </div>
                }
            </div>

            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-5">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, searchString = ViewBag.SearchString })">Trước</a>
                        </li>
                        
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, searchString = ViewBag.SearchString })">@i</a>
                            </li>
                        }

                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, searchString = ViewBag.SearchString })">Sau</a>
                        </li>
                    </ul>
                </nav>
            }

        </section>
    </div>

    <button class="chat-btn" id="toggleChatBtn" onclick="toggleChat()"><i class="bi bi-robot"></i></button>

    <div class="chat-window" id="chatWindow">
        <div class="chat-header">
            <span>BookGate AI Assistant</span>
            <i class="bi bi-x-lg" style="cursor:pointer" onclick="toggleChat()"></i>
        </div>
        <div class="chat-body" id="chatBody">
            <div class="msg msg-ai">Xin chào! Mình là trợ lý AI của BookGate. Bạn đang tìm thể loại sách như thế nào?</div>
        </div>
        <div class="chat-input-area">
            <input type="text" id="chatInput" placeholder="Nhập tin nhắn..." onkeypress="handleEnter(event)">
            <button onclick="sendMessage()"><i class="bi bi-send-fill"></i></button>
        </div>
    </div>
    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 pe-lg-5 mb-4 mb-lg-0">
                    <div class="footer-logo mb-3">
                        <i class="bi bi-book"></i>
                    </div>
                    <p class="text-muted" style="font-size: 0.85rem; line-height: 1.6;">
                        Book Gate là nền tảng đọc sách trực tuyến hàng đầu, mang đến cho bạn không gian khám phá tri thức vô tận.
                    </p>
                </div>
                <div class="col-lg-2 d-none d-lg-block"></div>
                <div class="col-6 col-lg-2">
                    <h6 class="footer-title">Khám phá</h6>
                    <ul class="footer-links">
                        <li><a href="#">Về chúng tôi</a></li>
                        <li><a href="#">Blog</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="footer-title">Trợ giúp</h6>
                    <ul class="footer-links">
                        <li><a href="#">Hỗ trợ</a></li>
                        <li><a href="#">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-12 col-lg-2 mt-4 mt-lg-0">
                    <h6 class="footer-title">Theo dõi</h6>
                    <ul class="footer-links">
                        <li><a href="#"><i class="bi bi-facebook me-2"></i> Facebook</a></li>
                        <li><a href="#"><i class="bi bi-instagram me-2"></i> Instagram</a></li>
                    </ul>
                </div>
            </div>
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-5 pt-4 border-top" style="font-size: 0.8rem; color: #a4b0be;">
                <p class="mb-2 mb-md-0">Copyright © 2026 BookGate. All rights reserved.</p>
                <div class="d-flex gap-3">
                    <a href="#" class="text-decoration-none text-muted">Điều khoản</a>
                    <a href="#" class="text-decoration-none text-muted">Bảo mật</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function toggleChat() {
            const win = document.getElementById('chatWindow');
            win.style.display = win.style.display === 'flex' ? 'none' : 'flex';
        }

        function handleEnter(e) { 
            if(e.key === 'Enter') sendMessage(); 
        }

        function sendMessage() {
            const input = document.getElementById('chatInput');
            const text = input.value.trim();
            if(!text) return;

            // In tin nhắn của user ra màn hình
            appendMessage(text, 'msg-user');
            input.value = '';

            // Hiển thị AI đang gõ
            const typingId = appendMessage("Đang suy nghĩ...", 'msg-ai');

            // Gọi API lên C#
            fetch('@Url.Action("AskAI", "Member")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(text)
            })
            .then(res => res.json())
            .then(data => {
                // Xóa chữ đang suy nghĩ và in kết quả thật
                document.getElementById(typingId).remove();
                appendMessage(data.reply, 'msg-ai');
            })
            .catch(err => {
                document.getElementById(typingId).remove();
                appendMessage("Lỗi kết nối đến máy chủ AI!", 'msg-ai');
            });
        }

        function appendMessage(text, className) {
            const id = 'msg-' + Date.now();
            const chatBody = document.getElementById('chatBody');
            const msgDiv = document.createElement('div');
            msgDiv.id = id;
            msgDiv.className = 'msg ' + className;
            // Thay thế \n bằng thẻ <br> để AI xuống dòng hiển thị đẹp hơn
            msgDiv.innerHTML = text.replace(/\n/g, '<br>'); 
            chatBody.appendChild(msgDiv);
            chatBody.scrollTop = chatBody.scrollHeight; // Cuộn xuống dưới cùng
            return id;
        }
    </script>
    @if (TempData["Message"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                Swal.fire({
                    icon: 'success',
                    title: 'Tuyệt vời!',
                    text: '@Html.Raw(TempData["Message"])',
                    confirmButtonColor: '#009dff',
                    timer: 3000, 
                    timerProgressBar: true
                });
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                Swal.fire({
                    icon: 'error',
                    title: 'Rất tiếc!',
                    text: '@Html.Raw(TempData["Error"])',
                    confirmButtonColor: '#ff7675'
                });
            });
        </script>
    }
</body>
</html>